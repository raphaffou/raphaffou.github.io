# -----------------------------------------------------------------------------
#  Research
# -----------------------------------------------------------------------------

:jsi-internship a schema:Role ;
    schema:name "Research internship in NLP" ;
    schema:startDate "2026-06"^^xsd:gYearMonth ;
    schema:endDate "2026-08"^^xsd:gYearMonth ;
    schema:memberOf :jsi ;
    schema:description "Summer 2026 in the Knowledge Laboratory of the Jožef Stefan Institute, working with Matej Martinc on readability assessment with large language models." .

:readability-paper a schema:ScholarlyArticle ;
    site:slug "readability-llms" ;
    site:order 1 ;
    site:label "Readability with LLMs" ;
    schema:name "Assessing Readability with LLMs: The Role of Reasoning and Few-Shot Prompting" ;
    schema:author ( "Raphaël Thieffry" "Matej Martinc" ) ;
    schema:datePublished "2026-09"^^xsd:gYearMonth ;
    schema:url <https://arxiv.org/abs/2609.24650> ;
    site:status "Preprint on arXiv · submitted to ECIR 2027, under review" ;
    site:venue "ECIR 2027" ;
    site:venueUrl <https://www.ecir2027.co.uk/> ;
    schema:isPartOf :jsi-internship ;
    schema:about :nlp, :llms ;
    site:summary "A systematic benchmark of open-source LLMs for readability assessment in English and Slovenian, the first to study how explicit reasoning and few-shot prompting change their predictions of discrete readability levels." ;
    site:problem "Readability formulas transfer poorly across genres and languages, and supervised models need annotated corpora that rarely exist for less-resourced languages such as Slovenian." ;
    site:approach "Five open-weight LLMs, four corpora (three English, one Slovenian), no training at all: we vary only the prompt — its format, zero to three labelled examples per level, and whether the model answers directly or reasons first — and compare the best configuration with classical formulas and supervised models." ;
    site:result "Reasoning before answering brings large gains, especially for models that reason natively, and the first labelled example per level carries most of the few-shot benefit. The best configuration, with no training, beats every classical formula on the Slovenian textbook corpus and on WeeBit." ;
    site:stack "Python", "vLLM", "open-weight LLMs", "chain-of-thought", "few-shot prompting" ;
    site:codeNote "Code will be released after the review period." .

# -----------------------------------------------------------------------------
#  Projects (site:featured true → home page and Projects page; false → archive;
#  site:aiAssisted true → the AI-assisted section)
