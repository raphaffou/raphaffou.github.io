# =============================================================================
#  portfolio.ttl — the single source of content for raphaffou.github.io
#
#  Edit this file, then run `npm run build` (or `npm start` while developing).
#  scripts/build-content.mjs turns it into:
#    - the pages of the site (src/app/content/content.generated.ts)
#    - JSON-LD for search engines (public/data/portfolio.jsonld)
#    - this file itself, published at /data/portfolio.ttl
#    - the Graph page (src/app/content/graph.generated.ts)
#
#  Vocabulary: schema.org for what it already describes, plus a small `site:`
#  namespace for what only this site needs (order, slugs, case-study fields).
#  Texts are in English. Keep summaries to 2–3 sentences.
#
#  Order of values: when a property has several values ("Python", "C", …),
#  the site shows them in the order written here.
#  Optional site:label gives a shorter name for the Graph page.
# =============================================================================

@prefix :       <https://raphaffou.github.io/#> .
@prefix schema: <https://schema.org/> .
@prefix site:   <https://raphaffou.github.io/ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
#  Me
# -----------------------------------------------------------------------------

:me a schema:Person ;
    schema:name "Raphaël Thieffry" ;
    schema:jobTitle "M2 student in Hybrid AI — knowledge graphs & NLP" ;
    schema:description "I work on hybrid uses of symbolic and probabilistic AI: knowledge graphs, ontologies and language models. I am looking for a research internship from March 2027, and for a PhD." ;
    schema:email "raphael.thieffry@gmail.com" ;
    schema:address "Paris-Saclay, France" ;
    site:availability "Open to research internships (from March 2027) and PhD positions" ;
    site:cv </cv/Raphael_Thieffry_CV.pdf> ;
    site:github <https://github.com/raphaffou> ;
    site:linkedin <https://bit.ly/4a04L7l> ;
    schema:sameAs <https://github.com/raphaffou>, <https://bit.ly/4a04L7l> ;
    schema:affiliation :paris-saclay ;
    schema:alumniOf :polytech, :paris-saclay ;
    schema:knowsAbout :knowledge-graphs, :nlp, :llms, :machine-learning ;
    site:bio """I studied mathematics and computer science at Université Paris-Saclay, then spent three years as an apprentice engineer in industry, working on Linux infrastructure and data mining, while completing an engineering degree at Polytech Paris-Saclay (17/20).

In 2026 I chose to move into research: a summer at the Jožef Stefan Institute in Ljubljana, where I wrote my first paper on LLMs and readability, then the M2 Data, Knowledge and Hybrid AI at Université Paris-Saclay.

What I want to work on sits where symbolic and statistical AI meet: knowledge graphs and ontologies that language models can use, and language models that help build them.""" .

