:rent-prediction a schema:SoftwareSourceCode ;
    site:slug "rent-prediction" ;
    site:order 1 ;
    site:featured true ;
    schema:name "Rent prediction" ;
    schema:dateCreated "2026" ;
    schema:codeRepository <https://github.com/raphaffou/Pr-diction-Immobili-re> ;
    schema:about :machine-learning ;
    site:summary "Predicting the rent of housing listings from their characteristics, for the machine learning course of my last year at Polytech Paris-Saclay." ;
    site:problem "About 4,500 rental listings with heterogeneous, partly missing features, and a price to predict." ;
    site:approach "Parsing and feature engineering, then scikit-learn pipelines comparing linear and ensemble models, with automated training runs." ;
    site:result "One of the best results of the class." ;
    site:role "Team of three. I designed the overall approach and wrote the main training logic; Antonin Russac did the visualisation and feature engineering, and Ethan Puyaubreau the training automation." ;
    site:stack "Python", "pandas", "scikit-learn", "Jupyter" .

:web-shop a schema:SoftwareSourceCode ;
    site:slug "web-shop" ;
    site:order 2 ;
    site:featured true ;
    schema:name "3D web shop" ;
    schema:dateCreated "2023–2024" ;
    schema:codeRepository <https://github.com/raphaffou/projetWebPoly> ;
    schema:url <https://projet-web-poly.vercel.app> ;
    schema:about :web ;
    site:summary "An online shop with 3D product scenes and animated pages, built for the web course at Polytech Paris-Saclay." ;
    site:problem "Build a complete shop, from the design in Figma to a working cart, with a real backend." ;
    site:approach "Angular front end with Three.js scenes and GSAP animations, one generated page per product, and an Express API backed by MariaDB." ;
    site:result "A live demo, deployed on Vercel." ;
    site:role "Course project." ;
    site:stack "Angular", "TypeScript", "Three.js", "GSAP", "Express", "MariaDB" .

